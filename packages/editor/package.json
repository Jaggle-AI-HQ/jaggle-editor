    "@lexical/rich-text": "0.51.0",
    "@lexical/selection": "0.51.0",
    "@lexical/table": "0.51.0",
    "@lexical/text": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@lexical/yjs": "0.51.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "happy-dom": "^20.14.5",
    "lexical": "0.51.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.0",
