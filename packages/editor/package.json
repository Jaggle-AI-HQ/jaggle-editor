{
  "name": "@jaggle-ai/editor",
  "version": "0.2.1",
  "description": "Jaggle's Lexical rich-text editor for React: document and comment editors with live collaboration, comment threads, version history, AI writing and import/export",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-shadcn-editor"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jaggle-AI-HQ/jaggle-editor",
    "directory": "packages/editor"
  },
  "keywords": [
    "lexical",
    "editor",
    "rich-text",
    "react",
    "yjs"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lexical/clipboard": "~0.51.0",
    "@lexical/code": "~0.51.0",
    "@lexical/code-shiki": "~0.51.0",
    "@lexical/extension": "~0.51.0",
    "@lexical/history": "~0.51.0",
    "@lexical/html": "~0.51.0",
    "@lexical/link": "~0.51.0",
    "@lexical/list": "~0.51.0",
    "@lexical/mark": "~0.51.0",
    "@lexical/markdown": "~0.51.0",
    "@lexical/react": "~0.51.0",
    "@lexical/rich-text": "~0.51.0",
    "@lexical/selection": "~0.51.0",
    "@lexical/table": "~0.51.0",
    "@lexical/text": "~0.51.0",
    "@lexical/utils": "~0.51.0",
    "@lexical/yjs": "~0.51.0",
    "@tanstack/react-query": "^5.0.0",
    "lexical": "~0.51.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yjs": "^13.6.0"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
