    "dompurify": "^3.3.3",
    "katex": "^0.16.21",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.11.1",
    "tailwind-merge": "^3.3.0",
    "y-websocket": "^2.1.0"
  },
  "devDependencies": {
