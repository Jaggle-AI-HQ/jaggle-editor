{
  "name": "playground",
  "private": true,
  "type": "module",
  "description": "Tries @jaggle-ai/editor the way an app uses it: Vite, Tailwind 4 and in-memory adapters",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5190 --strictPort",
    "typecheck": "tsc --noEmit",
    "collab-server": "HOST=localhost PORT=1234 y-websocket"
  },
  "dependencies": {
    "@jaggle-ai/editor": "*",
    "@lexical/clipboard": "0.51.0",
    "@lexical/code": "0.51.0",
    "@lexical/code-shiki": "0.51.0",
    "@lexical/extension": "0.51.0",
    "@lexical/history": "0.51.0",
    "@lexical/html": "0.51.0",
    "@lexical/link": "0.51.0",
    "@lexical/list": "0.51.0",
    "@lexical/mark": "0.51.0",
    "@lexical/markdown": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/rich-text": "0.51.0",
    "@lexical/selection": "0.51.0",
    "@lexical/table": "0.51.0",
    "@lexical/text": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@lexical/yjs": "0.51.0",
    "@tanstack/react-query": "^5.90.21",
    "lexical": "0.51.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.3",
    "yjs": "13.6.29"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "y-websocket": "^2.1.0"
  }
}
